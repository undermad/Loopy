{
  "name": "loopy",
  "version": "0.1.0",
  "description": "Desktop tool for game design and project management.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --dir",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project renderer",
    "test:unit:watch": "vitest --project unit --project renderer",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "secrets": "secretlint \"**/*\"",
    "knip": "knip",
    "docs": "npm --prefix docs run start",
    "docs:build": "npm --prefix docs run build",
    "prepare": "husky",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@xyflow/react": "^12.12.0",
    "dotenv": "^18.0.8",
    "i18next": "^26.4.7",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.20",
    "react-resizable-panels": "^4.14.5",
    "tinykeys": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "cspell": "^10.4.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.2",
    "secretlint": "^13.0.7",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "@parcel/watcher": false
  }
}
